# Copy this file to `.env` and fill in the values. `.env` is git-ignored.
#
# This bot uses TWO Telegram channels:
#   - INPUT  : your own account reads "Saved Messages" (durable; survives weekends).
#   - REPLY  : a bot sends confirmations to your bot DM.

# --- Input: your Telegram user account (Telethon) ---
# Create an app at https://my.telegram.org (API development tools) to get these.
TELEGRAM_API_ID=1234567
TELEGRAM_API_HASH=0123456789abcdef0123456789abcdef

# Where the Telethon login session is stored. Default: state/contextbot.session
# TELEGRAM_SESSION=~/Projects/telegram-bot/state/contextbot.session

# --- Reply: your bot (Bot API) ---
# Create a bot with @BotFather and press Start on it once, then paste the token here.
TELEGRAM_BOT_TOKEN=123456:ABC-DEF_your_token_here

# Optional: override the reply target chat id. Normally derived from your account id.
# OWNER_CHAT_ID=000000000

# --- Output ---
# Where generated notes are saved. Defaults to the shared MarkNotes inbox.
INBOX_DIR=~/Documents/MarkNotes/0_inbox

# Where document originals (pdf/txt/csv) are moved after their note is written.
# Created on demand. Default: ~/Downloads
# DOWNLOADS_DIR=~/Downloads

# (Sent images need no directory: they are encoded straight into the note, so there is no
# separate image file to keep. An image too large to embed is moved to DOWNLOADS_DIR instead.)

# Log verbosity: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# --- Phase 2 engine: Claude Code headless CLI (`claude -p`) ---
# Set to false to run fully offline: notes are still saved, just without LLM-derived
# title/tags/summary (the Phase 1 behaviour). Default: true.
# CLAUDE_ENABLED=true

# Path to the `claude` executable. Default: "claude" (resolved on PATH).
# CLAUDE_BIN=claude

# Model alias ('sonnet', 'opus', 'haiku') or a full model name. Default: sonnet
# CLAUDE_MODEL=sonnet

# Model for PDF → Markdown conversion. This reads a whole (often image-heavy) document and is
# measurably flakier than text enrichment, so it defaults to a stronger model than CLAUDE_MODEL.
# Lower it to sonnet/haiku to spend less plan usage at the cost of reliability. Default: opus
# CLAUDE_PDF_MODEL=opus

# Model for image → description/OCR notes. Unlike a PDF, a single image is a light job: sonnet
# described a Korean screenshot correctly on 5 of 5 runs (every figure transcribed), so this stays
# on the cheap default. Raise it to opus if a real photo ever proves harder. Default: sonnet
# CLAUDE_IMAGE_MODEL=sonnet

# Model for audio → meeting notes. Drafting from a transcript is a long *text* job, not a reading
# job, so it stays on the cheap default — the PDF route's flakiness was about rendering a document.
# Default: sonnet
# CLAUDE_MEETING_MODEL=sonnet

# Default per-job timeout in seconds. Default: 120
# CLAUDE_TIMEOUT_SEC=120

# How long the meeting-note drafting turn may run. Its own dial, not a floor over the setting above:
# how long a meeting takes to write up has nothing to do with how long a text memo may take.
# Measured: a real ~1-hour meeting (a 38KB transcript) took 423s over 3 turns — the model reads the
# transcript, then the glossary, then writes. The default is a **hang detector, not a budget**: an
# hour means "this is stuck", not "this is a long meeting". Being too generous costs nothing (the
# job is async — the app keeps working and you are not watching it); being too tight *destroys* the
# note, because a timeout degrades to a transcript-only note after the whole Whisper run and
# drafting pass have already been spent. Raise it if your meetings run very long.
# Default: 3600
# CLAUDE_MEETING_TIMEOUT_SEC=3600

# --- Phase 2 audio → meeting note (increment 5) ---
# Local speech-to-text. Runs on-device via mlx-whisper; no audio ever leaves the machine.
#
# IMPORTANT — the model is NOT installed by pip. WHISPER_MODEL is a HuggingFace repo id, and
# mlx-whisper downloads it (~1.5GB) the first time it is used. The bot refuses to do that inside a
# job you are waiting on, so run this once on a new machine:
#
#     .venv/bin/python scripts/download_model.py          # --check to see if you need it
#
# The health panel reports "model not downloaded" until you do. `ffmpeg` is needed too
# (brew install ffmpeg) — it is resolved the same way the claude CLI is, so a Dock-launched app
# finds it in /opt/homebrew/bin despite launchd's minimal PATH.
# Default: mlx-community/whisper-large-v3-turbo
# WHISPER_MODEL=mlx-community/whisper-large-v3-turbo

# Spoken language of your recordings. Whisper can detect it, but telling it beats letting it guess
# from the first few seconds of small talk. Default: ko
# WHISPER_LANGUAGE=ko

# The meeting glossary: STT mis-transcription → the word actually said (Whisper hears "티맵" as
# "팀웹"). Applied when drafting a meeting note, and appended to when you confirm a correction
# during review.
# The default is inside the MarkNotes vault on purpose: the vault is private and you already back
# it up whole to your own data repo, so the accumulated corrections ride that backup — and the bot
# never commits or pushes anything itself. It sits under `.claude/` because MarkNotes skips every
# entry starting with a dot, so it is not a note, is not searchable, and never shows in the vault.
# Missing is fine: meeting notes are still made, just without term corrections (the health panel
# says so).
# Default: ~/Documents/MarkNotes/.claude/contextbot/glossary.md
# GLOSSARY_PATH=~/Documents/MarkNotes/.claude/contextbot/glossary.md

# --- Phase 2 review loop (increment 4) ---
# How long a pending review waits for your reply in the bot DM before the bot gives up and saves
# the draft anyway, marked unreviewed. A review never ends empty-handed — expiring delivers the
# draft rather than discarding it (only replying `취소` discards).
# The default is not a taste call: the Bot API only retains updates for 24h, so a reply you send
# past that window while the app is closed is dropped by Telegram and the review could never be
# finished. Default: 24
# REVIEW_EXPIRY_HOURS=24
